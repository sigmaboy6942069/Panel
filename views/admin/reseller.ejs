<div class="toast-wrap" id="toastWrap"></div>

<script>
// ---------------------------------------------------------------------------
// Admin reseller console. All money is integer cents from the API.
// ---------------------------------------------------------------------------
const PLANS = <%- JSON.stringify(plans) %>;
const OS_IMAGES = <%- JSON.stringify(osImages) %>;
const USERS = <%- JSON.stringify(users) %>;
const WALLETS = <%- JSON.stringify(wallets) %>;
const SERVERS = <%- JSON.stringify(servers) %>;
const ORDERS = <%- JSON.stringify(orders) %>;
let PROVIDERS = <%- JSON.stringify(providers || []) %>;
let STATUS = <%- JSON.stringify(status) %>;
let walletUserId = null;
/** Provider currently being edited on the "Provider settings" tab. */
let editingProviderId = (STATUS && STATUS.providerId) || (PROVIDERS[0] && PROVIDERS[0].id) || null;
/** null = adding, otherwise the id being edited in the provider overlay. */
let providerFormId = null;

function providerById(id) {
  return PROVIDERS.find(function (p) { return p.id === id; }) || null;
}
function providerName(id) {
  const p = providerById(id);
  return p ? p.name : (id ? '#' + id : '—');
}

function money(cents) {
  if (cents === null || cents === undefined || isNaN(cents)) return '—';
  const n = Math.round(Number(cents));
  return (n < 0 ? '-' : '') + (Math.abs(n) / 100).toFixed(2) + ' €';
}
function esc(v) {
  return String(v === null || v === undefined ? '' : v).replace(/[&<>"']/g, function (c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
  });
}
function toast(msg, type) {
  const el = document.createElement('div');
  el.className = 'toast ' + (type || '');
  el.textContent = msg;
  document.getElementById('toastWrap').appendChild(el);
  setTimeout(() => el.remove(), 5200);
}
async function api(url, options) {
  const opts = Object.assign({ method: 'GET', cache: 'no-store', headers: {} }, options || {});
  const meta = document.querySelector('meta[name="csrf-token"]');
  if (meta && meta.content) opts.headers['X-CSRF-Token'] = meta.content;
  if (opts.body && typeof opts.body === 'object') {
    opts.headers['Content-Type'] = 'application/json';
    opts.body = JSON.stringify(opts.body);
  }
  const res = await fetch(url, opts);
  let data = {};
  try { data = await res.json(); } catch (_e) { data = {}; }
  if (!res.ok) { const e = new Error(data.error || ('Request failed (HTTP ' + res.status + ')')); e.code = data.code; e.details = data; throw e; }
  return data;
}
function showTab(name) {
  document.querySelectorAll('.tab').forEach(function (t) { t.classList.toggle('active', t.dataset.tab === name); });
  document.querySelectorAll('.pane').forEach(function (p) { p.classList.toggle('active', p.id === 'pane-' + name); });
  if (name === 'providers') loadProviders();
  if (name === 'orders') loadOrders();
  if (name === 'fleet') loadServers();
  if (name === 'wallets') renderWallets();
  if (name === 'logs') loadLogs();
}

// ------------------------------- status -----------------------------------

function renderStats() {
  if (!STATUS) { document.getElementById('statStrip').innerHTML = ''; return; }
  const u = STATUS.upstream, f = STATUS.fleet, o = STATUS.orders, c = STATUS.catalogue;
  const t = STATUS.totals || {};
  const cards = [
    { label: 'Upstream balance', value: u.balanceCents === null ? '—' : money(u.balanceCents), sub: (STATUS.providerName ? esc(STATUS.providerName) + ' · ' : '') + (u.reachable ? 'connected · ' + esc(u.account && u.account.username ? u.account.username : '') : (u.errorCode || 'not probed')), accent: u.reachable ? '#10B981' : '#EF4444' },
    { label: 'Providers', value: (t.enabled || 0) + ' / ' + (t.providers || 0), sub: (t.configured || 0) + ' with an API key', accent: '#8B5CF6' },
    { label: 'Monthly revenue', value: money(f.monthlyRetailCents), sub: 'cost ' + money(f.monthlyCostCents), accent: '#6366F1' },
    { label: 'Monthly margin', value: money(t.monthlyMarginCents || f.monthlyMarginCents), sub: (t.serversTotal || f.serversTotal) + ' servers across all providers', accent: '#22D3EE' },
    { label: 'Published plans', value: (t.plansEnabled || c.plansEnabled) + ' / ' + c.plansTotal, sub: c.osImages + ' OS images · synced ' + (c.lastSyncAt ? esc(c.lastSyncAt) : 'never'), accent: '#F59E0B' },
    { label: 'Order queue', value: o.pending + o.provisioning, sub: o.provisioned + ' provisioned · ' + o.failed + ' failed', accent: o.failed ? '#EF4444' : '#10B981' },
    { label: 'Customer credit', value: money(STATUS.wallet.totalBalanceCents), sub: STATUS.wallet.customersWithCredit + ' customers with credit', accent: '#10B981' },
    { label: 'Expiring ≤ 7 days', value: f.expiringSoon, sub: f.installing + ' building · ' + f.suspended + ' suspended', accent: f.expiringSoon ? '#F59E0B' : '#6B7280' },
  ];
  document.getElementById('statStrip').innerHTML = cards.map(function (c) {
    return '<div class="rs-stat" style="--accent:' + c.accent + '">' +
      '<div class="label">' + esc(c.label) + '</div>' +
      '<div class="value">' + esc(c.value) + '</div>' +
      '<div class="sub">' + (c.sub || '') + '</div>' +
    '</div>';
  }).join('');
}

function renderConfig() {
  if (!STATUS) return;
  document.getElementById('cfgEnabled').checked = !!STATUS.enabled;
  document.getElementById('cfgEnabledTop').checked = !!STATUS.enabled;
  document.getElementById('cfgStore').checked = !!STATUS.storeEnabled;
  api('/api/v1/reseller/admin/config').then(function (cfg) {
    document.getElementById('cfgLowBalance').value = (cfg.lowBalanceAlertCents / 100).toFixed(2);
    document.getElementById('cfgPoll').value = cfg.pollIntervalSec;
    document.getElementById('cfgSync').value = cfg.syncIntervalSec;
    document.getElementById('cfgMarkup').value = cfg.defaultMarkupPercent;
    document.getElementById('cfgTos').value = cfg.tosText || '';
    document.getElementById('cfgAutoRenew').checked = !!cfg.autoRenewDefault;
    document.getElementById('cfgConfigurator').checked = !!cfg.allowConfigurator;
  }).catch(function (e) { toast(e.message, 'error'); });

  // Per-provider connection fields
  const sel = document.getElementById('editProviderSelect');
  if (sel) {
    sel.innerHTML = PROVIDERS.length
      ? PROVIDERS.map(function (p) {
          return '<option value="' + p.id + '"' + (p.id === editingProviderId ? ' selected' : '') + '>' +
            esc(p.name) + (p.isDefault ? ' · default' : '') + (p.keyConfigured ? '' : ' · no key') + '</option>';
        }).join('')
      : '<option value="">No providers yet</option>';
  }
  const current = providerById(editingProviderId);
  if (current) {
    document.getElementById('cfgProviderName').value = current.name;
    document.getElementById('cfgBaseUrl').value = current.baseUrl || '';
    document.getElementById('cfgTimeout').value = current.requestTimeoutMs;
    document.getElementById('cfgProviderMarkup').value = current.markupPercent === null || current.markupPercent === undefined ? '' : current.markupPercent;
    document.getElementById('cfgProviderEnabled').checked = !!current.enabled;
    document.getElementById('cfgProviderStore').checked = !!current.storeEnabled;
    document.getElementById('cfgProviderNotes').value = current.notes || '';
    document.getElementById('cfgApiKey').placeholder = current.keyHint ? 'stored: ' + current.keyHint : 'paste this provider\'s API key';
    const isLocal = current.provider === 'local';
    document.getElementById('editProviderMeta').textContent =
      (current.isDefault ? 'default provider · ' : '') +
      (isLocal
        ? 'own-node provider (no upstream API)'
        : (current.keyConfigured ? 'key ' + (current.keyHint || 'configured') : 'no API key stored')) +
      (current.storeEnabled ? ' · storefront open' : ' · storefront closed');

    // Own-node providers do not talk to an upstream, so the API fields and the
    // balance card are not meaningful for them.
    const hide = isLocal ? 'none' : '';
    ['cfgBaseUrl', 'cfgApiKey'].forEach(function (id) {
      const el = document.getElementById(id);
      if (!el) return;
      el.disabled = isLocal;
      const wrap = el.closest('.f');
      if (wrap) wrap.style.display = hide;
    });
    const testBtn = document.getElementById('cfgTestBtn');
    if (testBtn) testBtn.style.display = hide;
  }

  const u = STATUS.upstream;
  const localSelected = current && current.provider === 'local';
  document.getElementById('connNote').textContent = u.checkedAt ? 'last probe ' + u.checkedAt + ' UTC' : '';
  let html = '';
  if (localSelected) {
    html = '<div class="alert" style="background:rgba(16,185,129,.08);border:1px solid rgba(16,185,129,.35)">' +
      '<strong>Own-node provider.</strong> Capacity is read live from your nodes. ' +
      '<button class="btn btn-sm" onclick="showLocalCapacity()" style="margin-left:8px">Discover capacity</button>' +
      '</div><div id="localCapacityBox" style="margin-top:10px"></div>';
  } else if (!STATUS.configured) {
    html = '<div class="alert alert-warn">No API key stored yet.</div>';
  } else if (u.account) {
    html = '<dl style="display:grid;grid-template-columns:auto 1fr;gap:6px 14px;font-size:13px;margin:0">' +
      '<dt style="color:var(--text-muted)">Upstream user</dt><dd style="margin:0;color:var(--text-primary);font-weight:600">' + esc(u.account.username) + ' (' + esc(u.account.userId) + ')</dd>' +
      '<dt style="color:var(--text-muted)">Email</dt><dd style="margin:0">' + esc(u.account.email) + '</dd>' +
      '<dt style="color:var(--text-muted)">Role / state</dt><dd style="margin:0">' + esc(u.account.role) + ' · ' + esc(u.account.state) + '</dd>' +
      '<dt style="color:var(--text-muted)">API key name</dt><dd style="margin:0">' + esc((u.account.api && u.account.api.keyName) || '—') + '</dd>' +
      '<dt style="color:var(--text-muted)">Balance</dt><dd style="margin:0;font-weight:700;color:#10B981">' + money(u.balanceCents) + '</dd>' +
      '<dt style="color:var(--text-muted)">Rate limits</dt><dd style="margin:0">' + (u.rateLimit && u.rateLimit.limit !== null ? u.rateLimit.limit + ' req/min · ' + u.rateLimit.remaining + ' left' : '—') + '</dd>' +
      '</dl>';
    if (u.resellerInfo) {
      const ri = u.resellerInfo;
      html += '<div style="margin-top:11px;font-size:12px;color:var(--text-muted)">KVM tier <strong style="color:var(--text-primary)">' + esc((ri.kvm && ri.kvm.tier) || '—') + '</strong>' +
        (ri.productValue ? ' · product value ' + esc(ri.productValue.monthly) + ' EUR/mo (level ' + esc(ri.productValue.level) + ')' : '') + '</div>';
    }
  } else {
    html = '<div class="alert alert-error">' + esc(u.error || 'Provider not reachable') + (u.errorCode ? ' <code>' + esc(u.errorCode) + '</code>' : '') + '</div>';
  }
  document.getElementById('upstreamBox').innerHTML = html;
}

async function loadStatus(probe) {
  try {
    const qs = [];
    if (probe === false) qs.push('probe=0');
    if (editingProviderId) qs.push('providerId=' + encodeURIComponent(editingProviderId));
    STATUS = await api('/api/v1/reseller/admin/status' + (qs.length ? '?' + qs.join('&') : ''));
    renderStats();
    renderConfig();
    if (Array.isArray(STATUS.providers)) {
      PROVIDERS = STATUS.providers;
      renderProviders();
    }
    if (probe === true) toast(STATUS.upstream.reachable ? 'Provider reachable' : 'Provider not reachable', STATUS.upstream.reachable ? 'success' : 'error');
  } catch (e) { toast(e.message, 'error'); }
}

async function saveConfig() {
  // Panel-wide settings live on `settings`; connection details are per provider.
  const payload = {
    enabled: document.getElementById('cfgEnabled').checked,
    storeEnabled: document.getElementById('cfgStore').checked,
    autoRenewDefault: document.getElementById('cfgAutoRenew').checked,
    allowConfigurator: document.getElementById('cfgConfigurator').checked,
    defaultMarkupPercent: Number(document.getElementById('cfgMarkup').value),
    lowBalanceAlertCents: Math.round(Number(document.getElementById('cfgLowBalance').value || 0) * 100),
    pollIntervalSec: Number(document.getElementById('cfgPoll').value),
    syncIntervalSec: Number(document.getElementById('cfgSync').value),
    tosText: document.getElementById('cfgTos').value,
  };
  const key = document.getElementById('cfgApiKey').value.trim();

  try {
    if (editingProviderId) {
      const provPayload = {
        name: document.getElementById('cfgProviderName').value.trim(),
        baseUrl: document.getElementById('cfgBaseUrl').value.trim(),
        requestTimeoutMs: Number(document.getElementById('cfgTimeout').value),
        markupPercent: document.getElementById('cfgProviderMarkup').value === ''
          ? null
          : Number(document.getElementById('cfgProviderMarkup').value),
        enabled: document.getElementById('cfgProviderEnabled').checked,
        storeEnabled: document.getElementById('cfgProviderStore').checked,
        notes: document.getElementById('cfgProviderNotes').value.trim(),
      };
      if (key) provPayload.apiKey = key;
      await api('/api/v1/reseller/admin/providers/' + editingProviderId, { method: 'PUT', body: provPayload });
    }
    await api('/api/v1/reseller/admin/config', { method: 'PUT', body: payload });
    document.getElementById('cfgApiKey').value = '';
    toast('Configuration saved', 'success');
    await loadProviders();
    loadStatus(true);
  } catch (e) { toast(e.message, 'error'); }
}

async function testConnection() {
  try {
    toast('Contacting provider…');
    const url = editingProviderId
      ? '/api/v1/reseller/admin/providers/' + editingProviderId + '/test-connection'
      : '/api/v1/reseller/admin/test-connection';
    const r = await api(url, { method: 'POST' });
    if (r.ok) {
      toast('Connected as ' + (r.account ? r.account.username : 'unknown') + ' · balance ' + money(r.balanceCents), 'success');
    } else {
      toast('Failed: ' + (r.error || r.errorCode || 'unknown'), 'error');
    }
    loadStatus(true);
  } catch (e) { toast(e.message, 'error'); }
}

async function clearKey() {
  if (!editingProviderId) { toast('No provider selected', 'error'); return; }
  if (!confirm('Remove the stored API key for "' + providerName(editingProviderId) + '"? That provider stops working until a new key is set.')) return;
  try {
    await api('/api/v1/reseller/admin/providers/' + editingProviderId, { method: 'PUT', body: { apiKey: '' } });
    toast('API key removed', 'success');
    await loadProviders();
    loadStatus(false);
  } catch (e) { toast(e.message, 'error'); }
}

// ------------------------------- providers --------------------------------

async function loadProviders() {
  try {
    const r = await api('/api/v1/reseller/admin/providers');
    PROVIDERS = r.providers || [];
    renderProviders();
  } catch (e) { toast(e.message, 'error'); }
}

function renderProviders() {
  const body = document.getElementById('providerRows');
  if (!body) return;
  const badge = document.getElementById('providersBadge');
  if (badge) badge.textContent = PROVIDERS.length ? '(' + PROVIDERS.length + ')' : '';
  if (!PROVIDERS.length) {
    body.innerHTML = '<tr><td colspan="9" style="text-align:center;color:var(--text-muted);padding:22px">' +
      'No providers configured yet — click <strong>Add provider</strong> to connect your first upstream reseller API.</td></tr>';
    return;
  }
  body.innerHTML = PROVIDERS.map(function (p) {
    const health = !p.keyConfigured
      ? '<span class="pill warn">no key</span>'
      : (p.lastError
          ? '<span class="pill err" title="' + esc(p.lastError) + '">error</span>'
          : (p.lastProbeAt ? '<span class="pill ok">reachable</span>' : '<span class="pill info">not probed</span>'));
    const balance = p.lastBalanceCents === null || p.lastBalanceCents === undefined
      ? '—'
      : '<span style="color:' + (p.lowBalanceAlert ? '#F59E0B' : '#10B981') + ';font-weight:700">' + money(p.lastBalanceCents) + '</span>';
    const actions = [
      '<button class="btn btn-sm" onclick="probeProvider(' + p.id + ')">probe</button>',
      '<button class="btn btn-sm" onclick="syncProvider(' + p.id + ')">sync</button>',
      '<button class="btn btn-sm" onclick="editProvider(' + p.id + ')">edit</button>',
      p.isDefault ? '<span class="pill info">default</span>' : '<button class="btn btn-sm" onclick="makeDefaultProvider(' + p.id + ')">default</button>',
      '<button class="btn btn-sm btn-danger" onclick="deleteProvider(' + p.id + ')">remove</button>',
    ].join(' ');
    return '<tr>' +
      '<td><strong>' + esc(p.name) + '</strong>' +
        '<div style="font-size:10px;color:var(--text-muted)">' + esc(p.slug) + ' · ' + esc(p.baseUrl) +
        (p.notes ? ' · ' + esc(p.notes) : '') + '</div></td>' +
      '<td class="mono" style="font-size:11px">' + (p.keyConfigured ? esc(p.keyHint || 'configured') : '<span style="color:#F59E0B">not set</span>') + '</td>' +
      '<td>' + (p.enabled
        ? '<span class="pill ok">enabled</span>'
        : '<span class="pill off">disabled</span>') +
        '<div style="font-size:10px;margin-top:2px">' + (p.storeEnabled ? 'storefront open' : 'storefront closed') + '</div></td>' +
      '<td>' + p.plansEnabled + ' / ' + p.plansTotal + '<div style="font-size:10px;color:var(--text-muted)">' + p.osImages + ' OS</div></td>' +
      '<td>' + p.serversTotal + '<div style="font-size:10px;color:var(--text-muted)">' + p.serversActive + ' active · ' + p.ordersPending + ' queued</div></td>' +
      '<td class="mono">' + balance + '</td>' +
      '<td style="font-size:11px">' + (p.lastSyncAt ? esc(String(p.lastSyncAt).slice(0, 16)) : 'never') + '</td>' +
      '<td>' + health + '</td>' +
      '<td style="white-space:nowrap">' + actions + '</td>' +
    '</tr>';
  }).join('');
}

/**
 * Reads live capacity from the nodes we own and shows what is sellable.
 * Used by the "Own nodes" provider type before syncing a catalogue.
 */
async function showLocalCapacity() {
  const box = document.getElementById('localCapacityBox');
  if (!box) return;
  box.innerHTML = '<div style="color:var(--text-muted);font-size:12px">Reading node capacity…</div>';
  try {
    const r = await api('/api/v1/reseller/admin/providers/local-capacity');
    const rows = r.capacity || [];
    if (!rows.length) {
      box.innerHTML = '<div class="alert alert-warn">No sellable capacity found. Add a node under ' +
        '<strong>Admin → Nodes</strong>, make sure it is online and not in maintenance, and that its ' +
        'capabilities have been detected.</div>';
      return;
    }
    box.innerHTML =
      '<div style="font-size:12px;color:var(--text-muted);margin-bottom:6px">' +
        rows.length + ' sellable configuration(s) across ' +
        (r.nodes || []).length + ' node(s) · engines: ' + esc((r.engines || []).join(', ')) +
      '</div>' +
      '<div class="table-wrap" style="max-height:280px;overflow:auto"><table><thead><tr>' +
        '<th>Node</th><th>Engine</th><th>Spec</th><th>Free</th><th></th>' +
      '</tr></thead><tbody>' +
      rows.map(function (c) {
        return '<tr>' +
          '<td>' + esc(c.nodeName) + '</td>' +
          '<td><span class="pill info">' + esc(c.engine.toUpperCase()) + '</span></td>' +
          '<td class="mono" style="font-size:11px">' + c.cores + ' vCPU · ' + c.memoryGb + ' GB · ' + c.diskGb + ' GB</td>' +
          '<td>' + (c.available > 0 ? '<span class="pill ok">' + c.available + '</span>' : '<span class="pill err">0</span>') + '</td>' +
          '<td><span style="font-size:10px;color:var(--text-muted)">' + esc(c.upstreamPlanId) + '</span></td>' +
        '</tr>';
      }).join('') +
      '</tbody></table></div>' +
      '<div style="margin-top:8px;font-size:12px">Next: click <strong>sync</strong> on this provider to turn ' +
      'this capacity into plans, then set your prices.</div>';
  } catch (e) {
    box.innerHTML = '<div class="alert alert-error">' + esc(e.message) + '</div>';
  }
}

function selectProvider(id) {
  editingProviderId = id;
  renderConfig();
  loadStatus(true);
}

function editProvider(id) {
  editingProviderId = id;
  showTab('provider');
  renderConfig();
}

/**
 * Own-node providers have no upstream API, so the URL/key fields are hidden and
 * the base-URL requirement is dropped.
 */
function onProviderTypeChange() {
  const isLocal = document.getElementById('provProvider').value === 'local';
  document.getElementById('provBaseUrlRow').style.display = isLocal ? 'none' : '';
  document.getElementById('provApiKeyRow').style.display = isLocal ? 'none' : '';
  document.getElementById('provLocalRow').style.display = isLocal ? '' : 'none';
  document.getElementById('provProviderHint').textContent = isLocal
    ? 'Sells capacity from the nodes you run. Orders are provisioned on your own hardware.'
    : 'Identifies the API dialect. Keep the default unless the upstream differs.';
}

function openProviderForm() {
  providerFormId = null;
  document.getElementById('provTitle').textContent = 'Add upstream provider';
  document.getElementById('provSubmit').textContent = 'Add provider';
  document.getElementById('provError').innerHTML = '';
  document.getElementById('provName').value = '';
  document.getElementById('provBaseUrl').value = 'https://bukkit-hosting.eu/api/v2';
  document.getElementById('provApiKey').value = '';
  document.getElementById('provProvider').value = 'bukkit-hosting';
  document.getElementById('provMarkup').value = '';
  document.getElementById('provTimeout').value = 20000;
  document.getElementById('provEnabled').checked = true;
  document.getElementById('provStore').checked = true;
  document.getElementById('provDefault').checked = PROVIDERS.length === 0;
  document.getElementById('provNotes').value = '';
  onProviderTypeChange();
  document.getElementById('providerOverlay').classList.add('open');
}

function closeProviderForm() {
  document.getElementById('providerOverlay').classList.remove('open');
}

async function submitProvider() {
  const btn = document.getElementById('provSubmit');
  const errBox = document.getElementById('provError');
  errBox.innerHTML = '';
  const payload = {
    name: document.getElementById('provName').value.trim(),
    baseUrl: document.getElementById('provBaseUrl').value.trim(),
    apiKey: document.getElementById('provApiKey').value.trim() || undefined,
    provider: document.getElementById('provProvider').value.trim() || undefined,
    markupPercent: document.getElementById('provMarkup').value === ''
      ? null
      : Number(document.getElementById('provMarkup').value),
    requestTimeoutMs: Number(document.getElementById('provTimeout').value),
    enabled: document.getElementById('provEnabled').checked,
    storeEnabled: document.getElementById('provStore').checked,
    makeDefault: document.getElementById('provDefault').checked,
    notes: document.getElementById('provNotes').value.trim() || null,
  };
  if (!payload.name) { errBox.innerHTML = '<div class="alert alert-error">A display name is required.</div>'; return; }
  if (payload.provider !== 'local' && !payload.baseUrl) {
    errBox.innerHTML = '<div class="alert alert-error">An API base URL is required.</div>';
    return;
  }
  btn.disabled = true;
  btn.textContent = 'Saving…';
  try {
    await api('/api/v1/reseller/admin/providers', { method: 'POST', body: payload });
    closeProviderForm();
    toast('Provider added', 'success');
    await loadProviders();
    editingProviderId = PROVIDERS.length ? PROVIDERS[PROVIDERS.length - 1].id : editingProviderId;
    loadStatus(false);
  } catch (e) {
    errBox.innerHTML = '<div class="alert alert-error">' + esc(e.message) + '</div>';
  } finally {
    btn.disabled = false;
    btn.textContent = 'Add provider';
  }
}

async function probeAllProviders() {
  try {
    toast('Probing every provider…');
    const r = await api('/api/v1/reseller/admin/providers?probe=1');
    PROVIDERS = r.providers || [];
    renderProviders();
    const broken = PROVIDERS.filter(function (p) { return p.keyConfigured && p.lastError; });
    toast(broken.length ? broken.length + ' provider(s) unreachable' : 'All providers reachable', broken.length ? 'error' : 'success');
    loadStatus(false);
  } catch (e) { toast(e.message, 'error'); }
}

async function syncAllProviders() {
  try {
    toast('Syncing all provider catalogues…');
    const r = await api('/api/v1/reseller/admin/providers/sync', { method: 'POST' });
    const total = (r.results || []).reduce(function (a, x) { return a + (x.plansUpserted || 0); }, 0);
    toast('Synced ' + (r.results || []).length + ' provider(s), ' + total + ' plans total', r.ok ? 'success' : 'error');
    if (r.errors && r.errors.length) toast(r.errors.length + ' provider(s) failed — see the Providers tab', 'error');
    await loadPlans();
    await loadProviders();
    loadStatus(false);
  } catch (e) { toast(e.message, 'error'); }
}

async function saveGlobalEnabled(enabled) {
  try {
    await api('/api/v1/reseller/admin/config', { method: 'PUT', body: { enabled: enabled } });
    toast(enabled ? 'Reselling enabled for all providers' : 'Reselling disabled', 'success');
    document.getElementById('cfgEnabled').checked = enabled;
    loadStatus(false);
  } catch (e) {
    toast(e.message, 'error');
    document.getElementById('cfgEnabledTop').checked = !enabled;
  }
}
async function syncCatalogue(providerId) {
  // No provider given = sync the one being edited, or every provider.
  const target = providerId || editingProviderId;
  try {
    toast('Syncing catalogue from ' + (target ? providerName(target) : 'every provider') + '…');
    const r = await api('/api/v1/reseller/admin/providers/sync' + (target ? '?providerId=' + target : ''), { method: 'POST' });
    const ok = (r.results || []).reduce(function (a, x) { return a + (x.plansUpserted || 0); }, 0);
    const fresh = (r.results || []).reduce(function (a, x) { return a + (x.plansNew || 0); }, 0);
    const osCount = (r.results || []).reduce(function (a, x) { return a + (x.osUpserted || 0); }, 0);
    toast('Synced ' + ok + ' plans (' + fresh + ' new) and ' + osCount + ' OS images across ' + (r.results || []).length + ' provider(s)', 'success');
    if (fresh) toast(fresh + ' new plan(s) were added DISABLED — enable them in the catalogue tab.', 'info');
    if (r.errors && r.errors.length) toast(r.errors.length + ' provider(s) failed — see the Providers tab', 'error');
    await loadPlans();
    await loadProviders();
    loadStatus(false);
  } catch (e) { toast(e.message, 'error'); }
}

async function runSyncLoop() {
  try {
    toast('Running reconciliation…');
    const r = await api('/api/v1/reseller/admin/sync-loop', { method: 'POST' });
    toast('Retried ' + r.ordersRetried + ' order(s), ' + r.ordersProvisioned + ' provisioned, ' + r.serversUpdated + ' server(s) refreshed, ' + r.becameActive + ' became active', 'success');
    if (r.errors && r.errors.length) console.warn('[reseller] reconciliation errors', r.errors);
    loadStatus(false);
    loadOrders();
    loadServers();
  } catch (e) { toast(e.message, 'error'); }
}

// ------------------------------- catalogue --------------------------------

async function loadPlans() {
  try {
    const r = await api('/api/v1/reseller/admin/plans');
    PLANS.length = 0;
    (r.plans || []).forEach(function (p) { PLANS.push(p); });
    renderPlans();
    fillAdminOrderPlans();
  } catch (e) { toast(e.message, 'error'); }
}

function planProviderName(id) {
  if (!id) return '<span style="color:var(--text-muted)">legacy</span>';
  const p = providerById(id);
  return p
    ? '<span class="pill info" title="' + esc(p.baseUrl) + '">' + esc(p.name) + '</span>'
    : '<span class="pill warn">#' + esc(id) + '</span>';
}

function renderPlanProviderFilter() {
  const sel = document.getElementById('planProviderFilter');
  if (!sel) return;
  const current = sel.value;
  sel.innerHTML = '<option value="">All providers</option>' + PROVIDERS.map(function (p) {
    return '<option value="' + p.id + '">' + esc(p.name) + '</option>';
  }).join('');
  sel.value = current;
}

function renderPlans() {
  renderPlanProviderFilter();
  const q = (document.getElementById('planFilter').value || '').toLowerCase();
  const providerFilter = document.getElementById('planProviderFilter').value;
  const rows = PLANS.filter(function (p) {
    if (providerFilter && String(p.provider_id || '') !== providerFilter) return false;
    if (!q) return true;
    return (p.display_name + ' ' + (p.cpu_family || '') + ' ' + (p.cpu_label || '') + ' ' + providerName(p.provider_id)).toLowerCase().includes(q);
  });
  const body = document.getElementById('planRows');
  if (!rows.length) {
    body.innerHTML = '<tr><td colspan="17" style="text-align:center;color:var(--text-muted);padding:22px">No plans yet — sync the catalogue from the provider.</td></tr>';
    return;
  }
  body.innerHTML = rows.map(function (p) {
    const margin = (p.retail_cents || 0) - (p.cost_cents || 0);
    const marginPct = p.cost_cents ? Math.round((margin / p.cost_cents) * 100) : 0;
    return '<tr data-id="' + p.id + '">' +
      '<td><label class="switch"><input type="checkbox" ' + (p.is_enabled ? 'checked' : '') + ' onchange="togglePlan(' + p.id + ', \'is_enabled\', this.checked)"><span class="slider"></span></label></td>' +
      '<td><strong>' + esc(p.display_name) + '</strong><div style="font-size:10px;color:var(--text-muted)">' + esc(p.kind) + (p.slug ? ' · ' + esc(p.slug) : '') + '</div></td>' +
      '<td>' + planProviderName(p.provider_id) + '</td>' +
      '<td><span class="pill info">' + esc((p.cpu_label || p.cpu_family || '—')) + '</span>' +
        (p.engine ? '<div style="font-size:10px;margin-top:2px"><span class="pill ok">' +
          esc(String(p.engine).toUpperCase()) + ' on node #' + esc(p.node_id) + '</span></div>' : '') +
      '</td>' +
      '<td>' + p.cores + '</td><td>' + p.memory_gb + ' GB</td><td>' + p.disk_gb + ' GB</td>' +
      '<td>' + p.connection_gbit + ' Gb</td><td>' + p.ipv4_count + '/' + p.ipv6_count + '</td>' +
      '<td class="mono">' + money(p.cost_cents) + '</td>' +
      '<td><input class="cell" type="number" step="0.5" value="' + (p.retail_cents / 100).toFixed(2) + '" onchange="setPlanPrice(' + p.id + ', \'retail_cents\', this.value)"></td>' +
      '<td><input class="cell" type="number" step="0.5" value="' + (p.retail_renew_cents / 100).toFixed(2) + '" onchange="setPlanPrice(' + p.id + ', \'retail_renew_cents\', this.value)"></td>' +
      '<td><input class="cell" type="number" step="0.5" value="' + (p.setup_cents / 100).toFixed(2) + '" onchange="setPlanPrice(' + p.id + ', \'setup_cents\', this.value)"></td>' +
      '<td style="color:' + (margin >= 0 ? '#10B981' : '#F87171') + ';font-weight:700">' + money(margin) + '<div style="font-size:10px;font-weight:500">' + marginPct + '%</div></td>' +
      '<td><label class="switch"><input type="checkbox" ' + (p.is_visible ? 'checked' : '') + ' onchange="togglePlan(' + p.id + ', \'is_visible\', this.checked)"><span class="slider"></span></label></td>' +
      '<td>' + (p.engine
        ? (Number(p.stock) > 0
            ? '<span class="pill ok">' + p.stock + ' free</span>'
            : '<span class="pill err">sold out</span>')
        : (p.upstream_available ? '<span class="pill ok">in stock</span>' : '<span class="pill warn">no stock</span>')) + '</td>' +
      '<td><button class="btn btn-sm" onclick="quickPrice(' + p.id + ')">Apply markup</button></td>' +
    '</tr>';
  }).join('');
}

async function togglePlan(id, field, value) {
  const patch = {}; patch[field] = value;
  try {
    const r = await api('/api/v1/reseller/admin/plans/' + id, { method: 'PUT', body: patch });
    const idx = PLANS.findIndex(function (p) { return p.id === id; });
    if (idx >= 0) PLANS[idx] = r.plan;
    toast('Plan updated', 'success');
    fillAdminOrderPlans();
  } catch (e) { toast(e.message, 'error'); loadPlans(); }
}

async function setPlanPrice(id, field, euroValue) {
  const cents = Math.round(Number(euroValue) * 100);
  if (!Number.isFinite(cents) || cents < 0) { toast('Invalid price', 'error'); loadPlans(); return; }
  const patch = {}; patch[field] = cents;
  try {
    const r = await api('/api/v1/reseller/admin/plans/' + id, { method: 'PUT', body: patch });
    const idx = PLANS.findIndex(function (p) { return p.id === id; });
    if (idx >= 0) PLANS[idx] = r.plan;
    renderPlans();
    toast('Price saved', 'success');
  } catch (e) { toast(e.message, 'error'); loadPlans(); }
}

async function quickPrice(id) {
  const p = PLANS.find(function (x) { return x.id === id; });
  if (!p) return;
  const cfg = await api('/api/v1/reseller/admin/config').catch(function () { return null; });
  const markup = cfg ? cfg.defaultMarkupPercent : 20;
  const retail = Math.max(p.cost_cents, Math.round(Math.round(p.cost_cents * (1 + markup / 100)) / 50) * 50);
  await api('/api/v1/reseller/admin/plans/' + id, {
    method: 'PUT', body: { retail_cents: retail, retail_renew_cents: retail },
  });
  toast('Retail set to ' + money(retail) + ' (cost + ' + markup + '%)', 'success');
  loadPlans();
}

function renderOs() {
  const body = document.getElementById('osRows');
  if (!OS_IMAGES.length) {
    body.innerHTML = '<tr><td colspan="7" style="text-align:center;color:var(--text-muted);padding:18px">No OS images synced yet.</td></tr>';
    return;
  }
  body.innerHTML = OS_IMAGES.map(function (o) {
    return '<tr>' +
      '<td class="mono">' + esc(o.upstream_os_id) + '</td>' +
      '<td><strong>' + esc(o.display_name) + '</strong></td>' +
      '<td>' + esc(o.family) + '</td>' +
      '<td>' + (o.is_windows ? '<span class="pill info">yes</span>' : '<span class="pill off">no</span>') + '</td>' +
      '<td>' + (o.min_disk_gb ? o.min_disk_gb + ' GB' : '—') + '</td>' +
      '<td>' + o.sort_order + '</td>' +
      '<td>' + (o.is_enabled ? '<span class="pill ok">enabled</span>' : '<span class="pill off">hidden</span>') + '</td>' +
    '</tr>';
  }).join('');
}

// ------------------------- custom configuration plan -----------------------

async function openConfigPlan() {
  document.getElementById('cfgPlanOverlay').classList.add('open');
  document.getElementById('cpQuote').innerHTML = 'Loading configurator…';
  fillProviderSelect('cpProvider', editingProviderId);
  try {
    const r = await api('/api/v1/reseller/admin/configurator?providerId=' + encodeURIComponent(document.getElementById('cpProvider').value));
    const list = r.configurator || [];
    const sel = document.getElementById('cpCpu');
    sel.innerHTML = list.length
      ? list.map(function (c) { return '<option value="' + esc(c.cpu) + '">' + esc(c.cpu) + (c.available ? '' : ' (unavailable)') + '</option>'; }).join('')
      : '<option value="">No configurator CPUs available</option>';
    window.__cfgList = list;
    loadConfigurator();
  } catch (e) {
    document.getElementById('cpQuote').innerHTML = '<span style="color:#F87171">' + esc(e.message) + '</span>';
  }
}

function loadConfigurator() {
  const cpu = document.getElementById('cpCpu').value;
  const cfg = (window.__cfgList || []).find(function (c) { return c.cpu === cpu; });
  const box = document.getElementById('cfgPlanLimits');
  if (!cfg) { box.style.display = 'none'; return; }
  box.style.display = 'block';
  const l = cfg.limits;
  box.innerHTML = '<strong>' + esc(cpu) + '</strong> limits — cores ' + l.cores.min + '–' + l.cores.max + ' (step ' + l.cores.step + '), ' +
    'RAM ' + l.memory.min + '–' + l.memory.max + ' GB, disk ' + l.disk.min + '–' + l.disk.max + ' GB, ' +
    'IPv4 ' + l.ipv4.min + '–' + l.ipv4.max + ', IPv6 ' + l.ipv6.min + '–' + l.ipv6.max + '. ' +
    'Connection ' + cfg.connection + ' Gbit/s, duration ' + cfg.duration + ' month(s).' +
    (cfg.available ? '' : ' <span style="color:#F87171">Currently not orderable via API.</span>');
  document.getElementById('cpCores').min = l.cores.min;
  document.getElementById('cpCores').max = l.cores.max;
  document.getElementById('cpCores').step = l.cores.step;
  document.getElementById('cpMemory').min = l.memory.min;
  document.getElementById('cpMemory').max = l.memory.max;
  document.getElementById('cpDisk').min = l.disk.min;
  document.getElementById('cpDisk').max = l.disk.max;
  document.getElementById('cpDisk').step = l.disk.step;
  priceConfig();
}

let priceTimer = null;
function priceConfig() {
  clearTimeout(priceTimer);
  priceTimer = setTimeout(doPriceConfig, 420);
}
async function doPriceConfig() {
  const cpu = document.getElementById('cpCpu').value;
  if (!cpu) return;
  const box = document.getElementById('cpQuote');
  box.className = 'alert alert-info';
  box.textContent = 'Pricing…';
  const markup = document.getElementById('cpMarkup').value;
  try {
    const q = await api('/api/v1/reseller/admin/configurator/price?' + new URLSearchParams({
      providerId: document.getElementById('cpProvider').value,
      cpu: cpu,
      cores: document.getElementById('cpCores').value,
      memory: document.getElementById('cpMemory').value,
      disk: document.getElementById('cpDisk').value,
      ipv4: document.getElementById('cpIpv4').value,
      ipv6: document.getElementById('cpIpv6').value,
      markup: markup,
    }));
    box.innerHTML = 'Your cost <strong>' + money(q.costCents) + '</strong> · retail <strong>' + money(q.retailCents) + '</strong>' +
      ' · margin <strong style="color:#10B981">' + money(q.retailCents - q.costCents) + '</strong>' +
      (q.upstream && q.upstream.available === false ? ' · <span style="color:#F59E0B">not available upstream</span>' : '');
  } catch (e) {
    box.className = 'alert alert-error';
    box.textContent = e.message;
  }
}

async function createConfigPlan() {
  const payload = {
    providerId: Number(document.getElementById('cpProvider').value) || null,
    cpu: document.getElementById('cpCpu').value,
    cores: Number(document.getElementById('cpCores').value),
    memory: Number(document.getElementById('cpMemory').value),
    disk: Number(document.getElementById('cpDisk').value),
    ipv4: Number(document.getElementById('cpIpv4').value),
    ipv6: Number(document.getElementById('cpIpv6').value),
    markupPercent: document.getElementById('cpMarkup').value === '' ? '' : Number(document.getElementById('cpMarkup').value),
    setupCents: Math.round(Number(document.getElementById('cpSetup').value || 0) * 100),
    displayName: document.getElementById('cpName').value.trim(),
    description: document.getElementById('cpDesc').value.trim(),
    enable: true,
  };
  try {
    await api('/api/v1/reseller/admin/plans/config', { method: 'POST', body: payload });
    document.getElementById('cfgPlanOverlay').classList.remove('open');
    toast('Custom plan created and enabled', 'success');
    loadPlans();
    loadStatus(false);
  } catch (e) { toast(e.message, 'error'); }
}

// --------------------------------- orders ----------------------------------

async function loadOrders() {
  const status = document.getElementById('orderFilter').value;
  try {
    const r = await api('/api/v1/reseller/admin/orders?limit=200' + (status ? '&status=' + encodeURIComponent(status) : ''));
    ORDERS.length = 0;
    (r.orders || []).forEach(function (o) { ORDERS.push(o); });
    renderOrders();
  } catch (e) { toast(e.message, 'error'); }
}

function renderOrders() {
  const body = document.getElementById('orderRows');
  if (!ORDERS.length) {
    body.innerHTML = '<tr><td colspan="11" style="text-align:center;color:var(--text-muted);padding:22px">No orders yet.</td></tr>';
    return;
  }
  body.innerHTML = ORDERS.map(function (o) {
    const retryable = o.status === 'pending' || o.status === 'failed';
    return '<tr>' +
      '<td class="mono">' + esc(o.order_ref) + '</td>' +
      '<td>' + esc(o.customer_username || ('#' + o.user_id)) + '</td>' +
      '<td>' + (o.provider_name ? '<span class="pill info">' + esc(o.provider_name) + '</span>' : planProviderName(o.provider_id)) + '</td>' +
      '<td><strong>' + esc(o.server_name || '—') + '</strong><div style="font-size:10px;color:var(--text-muted)">' + esc(o.os_id || '') + '</div></td>' +
      '<td>' + esc(o.plan_name || (o.cpu_family ? o.cpu_family + ' ' + o.cores + 'c/' + o.memory_gb + 'G/' + o.disk_gb + 'G' : '—')) + '</td>' +
      '<td><span class="pill ' + esc(o.status) + '">' + esc(o.status) + '</span>' +
        (o.error_code ? '<div style="font-size:10px;color:#F87171;margin-top:3px">' + esc(o.error_code) + '</div>' : '') + '</td>' +
      '<td class="mono">' + money(o.charged_cents) + '</td>' +
      '<td class="mono">' + money(o.upstream_price_cents === null ? o.cost_cents : o.upstream_price_cents) + '</td>' +
      '<td class="mono" style="font-size:10px">' + (o.upstream_product_id ? esc(o.upstream_product_id).slice(0, 13) + '…' : '—') + '</td>' +
      '<td style="font-size:11px">' + esc((o.created_at || '').slice(0, 16)) + '</td>' +
      '<td style="white-space:nowrap">' +
        (o.error_message ? '<button class="btn btn-sm" title="' + esc(o.error_message) + '" onclick="alert(decodeURIComponent(\'' + encodeURIComponent(o.error_message) + '\'))">why</button> ' : '') +
        (retryable ? '<button class="btn btn-sm btn-primary" onclick="retryOrder(' + o.id + ')">retry</button> ' : '') +
        (o.status === 'pending' || o.status === 'failed' ? '<button class="btn btn-sm btn-danger" onclick="cancelOrder(' + o.id + ')">cancel</button> ' : '') +
        (o.upstream_product_id ? '<a class="btn btn-sm" href="/admin/reseller" onclick="return false;" title="' + esc(o.upstream_product_id) + '">upstream</a>' : '') +
      '</td>' +
    '</tr>';
  }).join('');
}

async function retryOrder(id) {
  try {
    toast('Retrying order…');
    const r = await api('/api/v1/reseller/admin/orders/' + id + '/retry', { method: 'POST' });
    toast('Order status: ' + r.order.status, r.order.status === 'provisioned' ? 'success' : 'info');
    loadOrders(); loadStatus(false); loadServers();
  } catch (e) { toast(e.message, 'error'); loadOrders(); }
}

async function cancelOrder(id) {
  if (!confirm('Cancel this queued order? Nothing already provisioned upstream is deleted.')) return;
  try {
    await api('/api/v1/reseller/admin/orders/' + id + '/cancel', { method: 'POST' });
    toast('Order cancelled', 'success');
    loadOrders();
  } catch (e) { toast(e.message, 'error'); }
}

function fillAdminOrderPlans() {
  const sel = document.getElementById('aoPlan');
  const enabled = PLANS.filter(function (p) { return p.is_enabled; });
  sel.innerHTML = enabled.length
    ? enabled.map(function (p) {
        return '<option value="' + p.id + '" data-cents="' + p.retail_cents + '">' +
          esc(p.display_name) + ' — ' + p.cores + ' vCPU / ' + p.memory_gb + ' GB / ' + p.disk_gb + ' GB — ' + money(p.retail_cents) + '</option>';
      }).join('')
    : '<option value="">No enabled plans — sync and enable plans first</option>';
  aoPrice();
}
function aoPrice() {
  const sel = document.getElementById('aoPlan');
  const opt = sel.options[sel.selectedIndex];
  const box = document.getElementById('aoResult');
  box.className = 'alert alert-info';
  box.textContent = opt && opt.dataset.cents ? 'This will charge ' + money(opt.dataset.cents) + ' according to the billing mode selected.' : '';
}

function fillProviderSelect(id, selectedId) {
  const sel = document.getElementById(id);
  if (!sel) return;
  const enabled = PROVIDERS.filter(function (p) { return p.enabled; });
  sel.innerHTML = enabled.length
    ? enabled.map(function (p) {
        return '<option value="' + p.id + '"' + (p.id === selectedId ? ' selected' : '') + '>' +
          esc(p.name) + (p.keyConfigured ? '' : ' · no API key') + (p.isDefault ? ' · default' : '') + '</option>';
      }).join('')
    : '<option value="">No enabled providers</option>';
}

function openAdminOrder() {
  fillProviderSelect('aoProvider', editingProviderId);
  const u = document.getElementById('aoUser');
  u.innerHTML = USERS.map(function (x) {
    return '<option value="' + x.id + '">' + esc(x.username) + (x.email ? ' (' + esc(x.email) + ')' : '') + ' · ' + esc(x.role) + '</option>';
  }).join('');
  const os = document.getElementById('aoOs');
  os.innerHTML = OS_IMAGES.filter(function (o) { return o.is_enabled; }).map(function (o) {
    return '<option value="' + esc(o.upstream_os_id) + '">' + esc(o.display_name) + '</option>';
  }).join('');
  fillAdminOrderPlans();
  document.getElementById('aoResult').innerHTML = '';
  document.getElementById('adminOrderOverlay').classList.add('open');
}

async function submitAdminOrder() {
  const btn = document.getElementById('aoSubmit');
  const planId = document.getElementById('aoPlan').value;
  if (!planId) { toast('Select a plan first.', 'error'); return; }
  btn.disabled = true; btn.textContent = 'Provisioning…';
  const box = document.getElementById('aoResult');
  box.innerHTML = '';
  try {
    const r = await api('/api/v1/reseller/admin/orders', {
      method: 'POST',
      body: {
        userId: Number(document.getElementById('aoUser').value),
        planId: Number(planId),
        providerId: Number(document.getElementById('aoProvider').value) || null,
        os: document.getElementById('aoOs').value,
        name: document.getElementById('aoName').value.trim() || null,
        hostname: document.getElementById('aoHostname').value.trim() || null,
        paymentMode: document.getElementById('aoPayment').value,
        autoRenew: document.getElementById('aoAutoRenew').value === '1',
        notes: document.getElementById('aoNotes').value.trim() || null,
      },
    });
    const o = r.order || {};
    box.className = 'alert alert-success';
    box.innerHTML = 'Order <strong>' + esc(o.orderRef) + '</strong> — status <strong>' + esc(o.status) + '</strong>.' +
      (o.primaryIpv4 ? ' IPv4 <strong>' + esc(o.primaryIpv4) + '</strong>.' : ' Building; IPs appear within minutes.') +
      (o.credentials ? '<br>Login: <strong>' + esc(o.credentials.username) + ' / ' + esc(o.credentials.password) + '</strong>' : '');
    toast('Order placed', 'success');
    loadOrders(); loadServers(); loadStatus(false);
  } catch (e) {
    box.className = 'alert alert-error';
    box.textContent = e.message;
    toast(e.message, 'error');
  } finally {
    btn.disabled = false; btn.textContent = 'Provision now';
  }
}

// --------------------------------- fleet -----------------------------------

async function loadServers() {
  try {
    const r = await api('/api/v1/reseller/admin/servers?limit=500');
    SERVERS.length = 0;
    (r.servers || []).forEach(function (s) { SERVERS.push(s); });
    renderServers();
  } catch (e) { toast(e.message, 'error'); }
}

function renderServers() {
  const q = (document.getElementById('fleetFilter').value || '').toLowerCase();
  const ownerName = function (id) {
    const u = USERS.find(function (x) { return x.id === id; });
    return u ? u.username : ('#' + id);
  };
  const rows = SERVERS.filter(function (s) {
    if (!q) return true;
    return (s.name + ' ' + (s.primaryIpv4 || '') + ' ' + (s.upstreamProductId || '') + ' ' + ownerName(s.userId) + ' ' + providerName(s.providerId)).toLowerCase().includes(q);
  });
  const body = document.getElementById('serverRows');
  const marginTotal = SERVERS.reduce(function (a, s) { return a + ((s.retailCents || 0) - (s.costCents || 0)); }, 0);
  const providerCount = {};
  SERVERS.forEach(function (s) { if (s.providerId) providerCount[s.providerId] = (providerCount[s.providerId] || 0) + 1; });
  document.getElementById('fleetNote').textContent = SERVERS.length + ' servers across ' +
    Object.keys(providerCount).length + ' provider(s) · monthly margin ' + money(marginTotal);
  if (!rows.length) {
    body.innerHTML = '<tr><td colspan="11" style="text-align:center;color:var(--text-muted);padding:22px">No servers provisioned yet.</td></tr>';
    return;
  }
  body.innerHTML = rows.map(function (s) {
    const margin = (s.retailCents || 0) - (s.costCents || 0);
    const stCls = s.suspended ? 'suspended' : (['install', 'reinstall', 'pending'].includes(s.state) ? 'install' : (s.powerStatus === 'running' ? 'running' : 'stopped'));
    const stLabel = s.suspended ? 'suspended' : (s.powerStatus && s.powerStatus !== 'unknown' ? s.state + '/' + s.powerStatus : s.state);
    return '<tr>' +
      '<td><strong>' + esc(s.name) + '</strong><div style="font-size:10px;color:var(--text-muted)">' + esc(s.cpuLabel || s.cpuFamily || '') + ' · ' + esc(s.osLabel || '') + '</div></td>' +
      '<td>' + esc(ownerName(s.userId)) + '</td>' +
      '<td>' + planProviderName(s.providerId) + '</td>' +
      '<td>' + s.cores + ' vCPU / ' + s.memoryGb + ' GB / ' + s.diskGb + ' GB</td>' +
      '<td class="mono">' + esc(s.primaryIpv4 || '—') + (s.primaryIpv6 ? '<div style="font-size:10px">' + esc(s.primaryIpv6) + '</div>' : '') + '</td>' +
      '<td><span class="pill ' + stCls + '">' + esc(stLabel) + '</span></td>' +
      '<td class="mono">' + money(s.retailCents) + '</td>' +
      '<td class="mono">' + money(s.costCents) + '</td>' +
      '<td class="mono" style="color:' + (margin >= 0 ? '#10B981' : '#F87171') + '">' + money(margin) + '</td>' +
      '<td style="font-size:11px">' + (s.expiresAt ? esc(s.expiresAt.slice(0, 10)) : '—') + (s.autoRenew ? ' <span class="pill ok">auto</span>' : '') + '</td>' +
      '<td style="white-space:nowrap">' +
        '<a class="btn btn-sm" href="/cloud/' + s.id + '">open</a> ' +
        '<button class="btn btn-sm" onclick="adminRenew(' + s.id + ')">renew</button> ' +
        (s.suspended
          ? '<button class="btn btn-sm" onclick="setSuspend(' + s.id + ', false)">unsuspend</button>'
          : '<button class="btn btn-sm btn-danger" onclick="setSuspend(' + s.id + ', true)">suspend</button>') +
      '</td>' +
    '</tr>';
  }).join('');
}

async function adminRenew(id) {
  if (!confirm('Renew this server upstream now? The customer wallet is charged when the server bills from the wallet.')) return;
  try {
    const r = await api('/api/v1/reseller/admin/servers/' + id + '/renew', { method: 'POST' });
    toast('Renewed — charged ' + money(r.chargedCents) + ', cost ' + money(r.costCents), 'success');
    loadServers(); loadStatus(false);
  } catch (e) { toast(e.message, 'error'); }
}

async function setSuspend(id, suspend) {
  let reason = null;
  if (suspend) {
    reason = prompt('Reason shown to the customer:');
    if (reason === null) return;
  }
  try {
    await api('/api/v1/reseller/admin/servers/' + id + (suspend ? '/suspend' : '/unsuspend'), {
      method: 'POST', body: { suspend: suspend, reason: reason },
    });
    toast(suspend ? 'Server suspended' : 'Server reactivated', 'success');
    loadServers();
  } catch (e) { toast(e.message, 'error'); }
}

// -------------------------------- wallets ----------------------------------

function renderWallets() {
  const bal = {};
  WALLETS.forEach(function (w) { bal[w.user_id] = w.balance_cents; });
  const counts = {};
  SERVERS.forEach(function (s) { counts[s.userId] = (counts[s.userId] || 0) + 1; });
  const body = document.getElementById('walletRows');
  body.innerHTML = USERS.map(function (u) {
    const b = bal[u.id] || 0;
    return '<tr>' +
      '<td><strong>' + esc(u.username) + '</strong></td>' +
      '<td>' + esc(u.email || '—') + '</td>' +
      '<td><span class="pill ' + (u.role === 'admin' ? 'info' : 'off') + '">' + esc(u.role) + '</span></td>' +
      '<td style="color:' + (b >= 0 ? '#10B981' : '#F87171') + ';font-weight:700">' + money(b) + '</td>' +
      '<td>' + (counts[u.id] || 0) + '</td>' +
      '<td><button class="btn btn-sm" onclick="openWallet(' + u.id + ')">Manage credit</button></td>' +
    '</tr>';
  }).join('');
}

async function openWallet(userId) {
  walletUserId = userId;
  const u = USERS.find(function (x) { return x.id === userId; });
  document.getElementById('wTitle').textContent = 'Credit — ' + (u ? u.username : '#' + userId);
  document.getElementById('wSubtitle').textContent = 'Positive amounts add credit, negative amounts withdraw it. Every entry is written to an auditable ledger.';
  document.getElementById('wAmount').value = '';
  document.getElementById('wDesc').value = '';
  document.getElementById('wLedger').innerHTML = '<div style="font-size:12px;color:var(--text-muted)">Loading ledger…</div>';
  document.getElementById('walletOverlay').classList.add('open');
  try {
    const r = await api('/api/v1/reseller/admin/wallet/' + userId);
    document.getElementById('wSubtitle').innerHTML = 'Current balance: <strong style="color:#10B981">' + money(r.balanceCents) + '</strong>';
    const rows = (r.entries || []).slice(0, 25).map(function (e) {
      return '<div style="display:flex;justify-content:space-between;gap:10px;font-size:12px;padding:5px 0;border-bottom:1px solid var(--border-subtle)">' +
        '<span style="color:var(--text-muted)">' + esc((e.created_at || '').slice(0, 16)) + ' · ' + esc(e.kind) + (e.reference ? ' · ' + esc(e.reference) : '') + '</span>' +
        '<span style="color:' + (e.delta_cents >= 0 ? '#10B981' : '#F87171') + ';font-weight:700">' + (e.delta_cents >= 0 ? '+' : '') + money(e.delta_cents) + '</span>' +
      '</div>';
    }).join('');
    document.getElementById('wLedger').innerHTML = rows || '<div style="font-size:12px;color:var(--text-muted)">No ledger entries yet.</div>';
  } catch (e) {
    document.getElementById('wLedger').innerHTML = '<div class="alert alert-error">' + esc(e.message) + '</div>';
  }
}

async function submitWallet() {
  const euro = Number(document.getElementById('wAmount').value);
  if (!Number.isFinite(euro) || euro === 0) { toast('Enter a non-zero amount in EUR.', 'error'); return; }
  try {
    const r = await api('/api/v1/reseller/admin/wallet/' + walletUserId + '/adjust', {
      method: 'POST',
      body: {
        amountCents: Math.round(euro * 100),
        kind: document.getElementById('wKind').value,
        description: document.getElementById('wDesc').value.trim() || undefined,
      },
    });
    toast('New balance ' + money(r.balanceCents), 'success');
    const idx = WALLETS.findIndex(function (w) { return w.user_id === walletUserId; });
    if (idx >= 0) WALLETS[idx].balance_cents = r.balanceCents;
    else WALLETS.push({ user_id: walletUserId, balance_cents: r.balanceCents });
    renderWallets();
    openWallet(walletUserId);
    loadStatus(false);
  } catch (e) { toast(e.message, 'error'); }
}

// --------------------------------- logs ------------------------------------

async function loadLogs() {
  const box = document.getElementById('logBox');
  box.innerHTML = '<div style="padding:14px;color:var(--text-muted);font-size:12px">Loading…</div>';
  try {
    const r = await api('/api/v1/reseller/admin/logs?limit=120');
    const logs = r.logs || [];
    if (!logs.length) {
      box.innerHTML = '<div style="padding:18px;text-align:center;color:var(--text-muted);font-size:12px">No upstream calls recorded yet.</div>';
      return;
    }
    box.innerHTML = logs.map(function (l) {
      const ok = l.state === 'success';
      const detail = l.error_code || (l.status_code || '');
      return '<div class="log-line" title="' + esc((l.request_body || '') + '\n' + (l.response_body || '')) + '">' +
        '<span>' + esc((l.created_at || '').slice(5, 19)) + '</span>' +
        '<span class="m">' + esc(l.method) + '</span>' +
        '<span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + esc(l.endpoint) + '</span>' +
        '<span class="pill ' + (ok ? 'ok' : 'err') + '">' + esc(detail) + '</span>' +
        '<span style="color:var(--text-muted)">' + (l.duration_ms || 0) + ' ms</span>' +
      '</div>';
    }).join('');
  } catch (e) {
    box.innerHTML = '<div class="alert alert-error">' + esc(e.message) + '</div>';
  }
}

// --------------------------------- init ------------------------------------

renderStats();
renderProviders();
renderConfig();
renderPlans();
renderOs();
renderOrders();
renderServers();
renderWallets();
loadProviders();
loadStatus(true);
setInterval(function () { loadStatus(false); }, 60000);
</script>
</body>
</html>
