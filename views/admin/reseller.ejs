<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0a0a0f">
  <title><%= title || 'Reseller - TGVPANEL' %></title>
  <link rel="icon" href="<%= siteLogo %>" type="image/png">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    .rs-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; margin-bottom: 18px; padding-bottom: 12px; border-bottom: 1px solid var(--border-subtle); }
    .rs-head h1 { margin: 0 0 5px 0; font-size: 22px; color: var(--text-primary); }
    .rs-head p { margin: 0; font-size: 13px; color: var(--text-muted); max-width: 780px; }

    .rs-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(168px, 1fr)); gap: 13px; margin-bottom: 18px; }
    .rs-stat { position: relative; background: var(--bg-card); border: 1px solid var(--border-card); border-radius: 12px; padding: 14px 16px; overflow: hidden; }
    .rs-stat::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--accent, #6366F1); }
    .rs-stat .label { font-size: 10px; text-transform: uppercase; letter-spacing: .6px; color: var(--text-muted); margin-bottom: 6px; }
    .rs-stat .value { font-size: 21px; font-weight: 800; color: var(--text-primary); line-height: 1.1; }
    .rs-stat .sub { font-size: 11px; color: var(--text-muted); margin-top: 4px; }

    .tabs { display: flex; gap: 4px; flex-wrap: wrap; border-bottom: 1px solid var(--border-subtle); margin-bottom: 16px; }
    .tab { padding: 9px 15px; font-size: 13px; font-weight: 600; color: var(--text-muted); background: none; border: none; border-bottom: 2px solid transparent; cursor: pointer; }
    .tab:hover { color: var(--text-primary); }
    .tab.active { color: #818cf8; border-bottom-color: #6366F1; }
    .pane { display: none; }
    .pane.active { display: block; }

    .card { background: var(--bg-card); border: 1px solid var(--border-card); border-radius: 13px; padding: 17px; margin-bottom: 16px; }
    .card h3 { margin: 0 0 13px 0; font-size: 14px; color: var(--text-primary); display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
    .card h3 .note { font-size: 11px; color: var(--text-muted); font-weight: 500; }

    .f-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 12px; }
    .f { display: flex; flex-direction: column; gap: 5px; }
    .f.full { grid-column: 1 / -1; }
    .f label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: var(--text-muted); }
    .f input, .f select, .f textarea { padding: 9px 11px; border-radius: 8px; border: 1px solid var(--border-color); background: rgba(255,255,255,.03); color: var(--text-primary); font-size: 13px; font-family: inherit; }
    .f input:focus, .f select:focus, .f textarea:focus { outline: none; border-color: #6366F1; box-shadow: 0 0 0 3px rgba(99,102,241,.12); }
    .f .hint { font-size: 11px; color: var(--text-muted); line-height: 1.45; }

    .btn { padding: 8px 14px; border-radius: 8px; border: 1px solid var(--border-color); background: transparent; color: var(--text-secondary); font-size: 12px; font-weight: 600; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
    .btn:hover { color: var(--text-primary); border-color: #6366F1; }
    .btn:disabled { opacity: .45; cursor: not-allowed; }
    .btn-primary { background: linear-gradient(135deg,#6366F1,#8B5CF6); border: none; color: #fff; }
    .btn-primary:hover { color: #fff; filter: brightness(1.08); }
    .btn-danger { border-color: rgba(239,68,68,.4); color: #F87171; }
    .btn-danger:hover { background: rgba(239,68,68,.12); color: #FCA5A5; }
    .btn-sm { padding: 5px 10px; font-size: 11px; }

    table.grid { width: 100%; border-collapse: collapse; font-size: 12px; }
    table.grid th, table.grid td { padding: 8px 10px; text-align: left; border-bottom: 1px solid var(--border-subtle); color: var(--text-secondary); vertical-align: middle; }
    table.grid th { font-size: 10px; text-transform: uppercase; letter-spacing: .5px; color: var(--text-muted); position: sticky; top: 0; background: var(--bg-card); }
    table.grid td.mono { font-family: 'SF Mono', ui-monospace, monospace; font-size: 11px; }
    table.grid td strong { color: var(--text-primary); }
    table.grid tr:hover td { background: rgba(255,255,255,.02); }
    .table-wrap { overflow-x: auto; max-height: 620px; overflow-y: auto; }
    table.grid input.cell, table.grid select.cell { padding: 5px 7px; border-radius: 6px; border: 1px solid var(--border-color); background: rgba(255,255,255,.03); color: var(--text-primary); font-size: 12px; width: 100%; min-width: 70px; }

    .pill { display: inline-flex; align-items: center; gap: 5px; padding: 2px 9px; border-radius: 999px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .4px; white-space: nowrap; }
    .pill .dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
    .pill.ok, .pill.running, .pill.active, .pill.provisioned, .pill.success { background: rgba(16,185,129,.15); color: #10B981; }
    .pill.off, .pill.stopped, .pill.disabled { background: rgba(107,114,128,.2); color: #9CA3AF; }
    .pill.warn, .pill.pending, .pill.provisioning, .pill.install { background: rgba(245,158,11,.17); color: #F59E0B; }
    .pill.err, .pill.failed, .pill.error, .pill.suspended { background: rgba(239,68,68,.15); color: #F87171; }
    .pill.info { background: rgba(6,182,212,.14); color: #22D3EE; }

    .alert { border-radius: 10px; padding: 11px 14px; font-size: 13px; margin-bottom: 12px; line-height: 1.5; }
    .alert-error { background: rgba(239,68,68,.12); border: 1px solid rgba(239,68,68,.32); color: #F87171; }
    .alert-info { background: rgba(6,182,212,.10); border: 1px solid rgba(6,182,212,.28); color: #22D3EE; }
    .alert-success { background: rgba(16,185,129,.12); border: 1px solid rgba(16,185,129,.32); color: #34D399; }
    .alert-warn { background: rgba(245,158,11,.12); border: 1px solid rgba(245,158,11,.32); color: #FBBF24; }

    .switch { position: relative; display: inline-block; width: 38px; height: 21px; }
    .switch input { opacity: 0; width: 0; height: 0; }
    .switch .slider { position: absolute; inset: 0; background: rgba(255,255,255,.12); border-radius: 999px; transition: .2s; cursor: pointer; }
    .switch .slider:before { content: ''; position: absolute; height: 15px; width: 15px; left: 3px; top: 3px; background: #fff; border-radius: 50%; transition: .2s; }
    .switch input:checked + .slider { background: #6366F1; }
    .switch input:checked + .slider:before { transform: translateX(17px); }

    .log-line { font-family: 'SF Mono', ui-monospace, monospace; font-size: 11px; padding: 6px 9px; border-bottom: 1px solid var(--border-subtle); color: var(--text-secondary); display: grid; grid-template-columns: 62px 52px 1fr 60px 74px; gap: 9px; align-items: center; }
    .log-line .m { font-weight: 700; color: #818cf8; }
    .overlay { position: fixed; inset: 0; background: rgba(0,0,0,.76); z-index: 2500; display: none; align-items: center; justify-content: center; padding: 20px; backdrop-filter: blur(5px); overflow-y: auto; }
    .overlay.open { display: flex; }
    .overlay-card { background: var(--bg-card); border: 1px solid var(--border-card); border-radius: 13px; max-width: 560px; width: 100%; padding: 20px; }
    .overlay-card h3 { margin: 0 0 9px 0; font-size: 16px; color: var(--text-primary); }
    .overlay-card p { margin: 0 0 15px 0; font-size: 13px; color: var(--text-secondary); line-height: 1.5; }
    .toast-wrap { position: fixed; right: 18px; bottom: 18px; z-index: 3000; display: flex; flex-direction: column; gap: 8px; }
    .toast { background: var(--bg-card); border: 1px solid var(--border-card); border-left: 3px solid #6366F1; border-radius: 10px; padding: 11px 15px; font-size: 13px; color: var(--text-primary); box-shadow: 0 12px 30px rgba(0,0,0,.45); max-width: 400px; }
    .toast.error { border-left-color: #EF4444; }
    .toast.success { border-left-color: #10B981; }
    .two-col { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; align-items: start; }
  </style>
</head>
<body>

<div class="admin-wrapper">
  <%- include('../partials/admin/sidebar') %>

  <div class="admin-main">
    <%- include('../partials/admin/header') %>

    <div class="admin-content">

      <div class="rs-head">
        <div>
          <h1>Reseller &amp; Upstream Provisioning</h1>
          <p>
            Sell servers from your upstream provider (Bukkit-Hosting, Düsseldorf). Sync their catalogue,
            set your own retail prices, and let customers provision instantly from the
            <a href="/store" style="color:#818cf8">storefront</a>. Orders go out with an idempotency key, so a
            timeout never buys the same server twice.
          </p>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <button class="btn" onclick="loadStatus(true)">Probe provider</button>
          <button class="btn" onclick="syncCatalogue()">Sync catalogue</button>
          <button class="btn btn-primary" onclick="runSyncLoop()">Run reconciliation</button>
        </div>
      </div>

      <div id="alerts">
        <% if (!status) { %>
          <div class="alert alert-error">Could not load reseller status.</div>
        <% } else if (!status.configured) { %>
          <div class="alert alert-warn">
            <strong>No upstream API key configured for this provider.</strong>
            Add a key on the <button class="btn btn-sm" onclick="showTab('provider')" style="margin:0 4px">Provider settings</button> tab,
            or connect another upstream account on the <button class="btn btn-sm" onclick="showTab('providers')" style="margin:0 4px">Providers</button> tab.
            Nothing is sold until a key is set and the provider is enabled.
          </div>
        <% } else if (!status.enabled) { %>
          <div class="alert alert-info">The integration is configured but <strong>disabled</strong>. Enable it on the Provider tab to start selling.</div>
        <% } else if (!status.upstream.reachable) { %>
          <div class="alert alert-error">
            Provider unreachable: <%= status.upstream.error || 'unknown error' %>
            <% if (status.upstream.errorCode) { %>(code <code><%= status.upstream.errorCode %></code>)<% } %>
          </div>
        <% } else if (status.lowBalanceAlert) { %>
          <div class="alert alert-warn">
            Upstream balance is low: <strong><%= ((status.upstream.balanceCents || 0) / 100).toFixed(2) %> EUR</strong>.
            New orders fail with <code>insufficient_balance</code> once it runs out.
          </div>
        <% } %>
      </div>

      <div class="rs-stats" id="statStrip"></div>

      <div class="tabs">
        <button class="tab active" data-tab="providers" onclick="showTab('providers')">Providers <span id="providersBadge"></span></button>
        <button class="tab" data-tab="provider" onclick="showTab('provider')">Provider settings</button>
        <button class="tab" data-tab="catalogue" onclick="showTab('catalogue')">Catalogue &amp; pricing</button>
        <button class="tab" data-tab="orders" onclick="showTab('orders')">Orders</button>
        <button class="tab" data-tab="fleet" onclick="showTab('fleet')">Fleet</button>
        <button class="tab" data-tab="wallets" onclick="showTab('wallets')">Customer credit</button>
        <button class="tab" data-tab="logs" onclick="showTab('logs')">Upstream API log</button>
      </div>

      <!-- ============================ PROVIDERS ============================ -->
      <div class="pane active" id="pane-providers">
        <div class="card">
          <h3>
            Upstream reseller APIs
            <span class="note">
              Each provider is an independent upstream account with its own API key, base URL and
              catalogue. Customers see one merged storefront; every order is fulfilled and billed
              against the provider that owns the plan.
            </span>
          </h3>
          <div style="display:flex;gap:8px;margin-bottom:13px;flex-wrap:wrap;align-items:center">
            <button class="btn btn-primary" onclick="openProviderForm()">+ Add provider</button>
            <button class="btn" onclick="probeAllProviders()">Probe all</button>
            <button class="btn" onclick="syncAllProviders()">Sync all catalogues</button>
            <span style="flex:1"></span>
            <span class="note" style="font-size:11px;color:var(--text-muted)">
              Panel-wide switch:
              <label class="switch" style="vertical-align:middle;margin-left:6px">
                <input type="checkbox" id="cfgEnabledTop" onchange="saveGlobalEnabled(this.checked)">
                <span class="slider"></span>
              </label>
            </span>
          </div>
          <div class="table-wrap">
            <table class="grid">
              <thead>
                <tr>
                  <th>Provider</th><th>Key</th><th>Selling</th><th>Plans</th><th>Servers</th>
                  <th>Balance</th><th>Last sync</th><th>Health</th><th></th>
                </tr>
              </thead>
              <tbody id="providerRows"></tbody>
            </table>
          </div>
        </div>

        <div class="card">
          <h3>How multi-provider reselling behaves</h3>
          <div class="two-col" style="font-size:13px;color:var(--text-secondary);line-height:1.6">
            <div>
              <strong style="color:var(--text-primary)">Catalogue</strong>
              <p style="margin:4px 0 0">
                <em>Sync catalogue</em> pulls plans and OS images per provider. Plans are stored with
                the provider that offered them, so identical plan names or upstream ids from two
                providers never collide. New plans always start disabled.
              </p>
            </div>
            <div>
              <strong style="color:var(--text-primary)">Ordering</strong>
              <p style="margin:4px 0 0">
                A package plan orders from its own provider. Custom configurations use the provider
                selected in the configurator. Idempotency keys, retries and the reconciliation loop
                are all provider-scoped.
              </p>
            </div>
            <div>
              <strong style="color:var(--text-primary)">Servers</strong>
              <p style="margin:4px 0 0">
                Every server remembers its provider, so power, console, reinstall, renewal and
                background refreshes always call the correct upstream API — even after a provider is
                renamed or its key rotated.
              </p>
            </div>
            <div>
              <strong style="color:var(--text-primary)">Removing</strong>
              <p style="margin:4px 0 0">
                A provider can only be removed once it has no provisioned servers and no open orders,
                so customers never lose access to a running VPS.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- ============================ PROVIDER ============================ -->
      <div class="pane" id="pane-provider">
        <div class="card" style="padding:13px 17px">
          <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;font-size:13px">
            <strong style="color:var(--text-primary)">Editing provider:</strong>
            <select id="editProviderSelect" onchange="selectProvider(Number(this.value))"
              style="padding:8px 11px;border-radius:8px;border:1px solid var(--border-color);background:rgba(255,255,255,.03);color:var(--text-primary);font-size:13px;min-width:240px">
            </select>
            <span id="editProviderMeta" class="note" style="font-size:11px;color:var(--text-muted)"></span>
            <span style="flex:1"></span>
            <button class="btn btn-sm" onclick="openProviderForm()">+ Add provider</button>
          </div>
        </div>
        <div class="two-col">
          <div class="card">
            <h3>Upstream connection <span class="note" id="connNote"></span></h3>
            <div class="f-grid">
              <div class="f full">
                <label for="cfgProviderName">Provider name</label>
                <input id="cfgProviderName" type="text" maxlength="80" placeholder="e.g. Bukkit-Hosting EU">
                <div class="hint">Shown to staff only — customers just see the plans.</div>
              </div>
              <div class="f full">
                <label for="cfgApiKey">Reseller API key</label>
                <input id="cfgApiKey" type="password" autocomplete="off" placeholder="<%= status && status.keyHint ? 'stored: ' + status.keyHint : 'your API key' %>">
                <div class="hint">
                  Stored AES-256-GCM encrypted in the panel vault — never in plaintext, never sent to the browser again.
                  Leave empty to keep the current key. For the default provider you can also set <code>RESELLER_API_KEY</code> in <code>.env</code>.
                </div>
              </div>
              <div class="f full">
                <label for="cfgBaseUrl">API base URL</label>
                <input id="cfgBaseUrl" type="text" value="<%= status ? status.baseUrl : 'https://bukkit-hosting.eu/api/v2' %>">
                <div class="hint">Provider API v2 root, without a trailing slash.</div>
              </div>
              <div class="f">
                <label for="cfgTimeout">Request timeout (ms)</label>
                <input id="cfgTimeout" type="number" min="2000" max="120000" step="500">
              </div>
              <div class="f">
                <label for="cfgProviderMarkup">Markup override (%) <span style="text-transform:none;font-weight:500">(blank = default)</span></label>
                <input id="cfgProviderMarkup" type="number" min="-90" max="1000" step="1">
                <div class="hint">Used for this provider's catalogue and quotes instead of the panel default.</div>
              </div>
              <div class="f">
                <label>Provider enabled</label>
                <label class="switch"><input type="checkbox" id="cfgProviderEnabled"><span class="slider"></span></label>
                <div class="hint">Master switch for this provider only.</div>
              </div>
              <div class="f">
                <label>Storefront open (this provider)</label>
                <label class="switch"><input type="checkbox" id="cfgProviderStore"><span class="slider"></span></label>
                <div class="hint">Lets customers buy this provider's plans from /store.</div>
              </div>
              <div class="f">
                <label for="cfgLowBalance">Low-balance alert (EUR)</label>
                <input id="cfgLowBalance" type="number" min="0" step="1">
                <div class="hint">Admins get a notification below this upstream balance, per provider.</div>
              </div>
              <div class="f">
                <label for="cfgPoll">Reconciliation interval (s)</label>
                <input id="cfgPoll" type="number" min="10" max="3600">
                <div class="hint">How often queued orders are retried and server states/IPs refreshed.</div>
              </div>
              <div class="f">
                <label for="cfgSync">Catalogue sync interval (s)</label>
                <input id="cfgSync" type="number" min="300" max="86400">
              </div>
              <div class="f full">
                <label for="cfgProviderNotes">Internal notes <span style="text-transform:none;font-weight:500">(optional)</span></label>
                <input id="cfgProviderNotes" type="text" maxlength="500" placeholder="Contract, account manager, region…">
              </div>
            </div>
            <div style="display:flex;gap:8px;margin-top:14px;flex-wrap:wrap">
              <button class="btn btn-primary" onclick="saveConfig()">Save connection</button>
              <button class="btn" id="cfgTestBtn" onclick="testConnection()">Test connection</button>
              <button class="btn btn-danger" onclick="clearKey()">Remove API key</button>
            </div>
          </div>

          <div>
            <div class="card">
              <h3>Selling</h3>
              <div class="f-grid">
                <div class="f">
                  <label>Integration enabled (all providers)</label>
                  <label class="switch"><input type="checkbox" id="cfgEnabled"><span class="slider"></span></label>
                  <div class="hint">Panel-wide master switch for every upstream call.</div>
                </div>
                <div class="f">
                  <label>Storefront open (all providers)</label>
                  <label class="switch"><input type="checkbox" id="cfgStore"><span class="slider"></span></label>
                  <div class="hint">Panel-wide switch; each provider also has its own storefront toggle.</div>
                </div>
                <div class="f">
                  <label>Auto-renew by default</label>
                  <label class="switch"><input type="checkbox" id="cfgAutoRenew"><span class="slider"></span></label>
                  <div class="hint">Pre-ticks auto-renewal at checkout.</div>
                </div>
                <div class="f">
                  <label>Allow custom configs</label>
                  <label class="switch"><input type="checkbox" id="cfgConfigurator"><span class="slider"></span></label>
                  <div class="hint">Lets staff build plans from the provider configurator.</div>
                </div>
                <div class="f">
                  <label for="cfgMarkup">Default markup (%)</label>
                  <input id="cfgMarkup" type="number" min="-90" max="1000" step="1">
                  <div class="hint">Applied to newly synced plans. Hand-set prices are never overwritten.</div>
                </div>
                <div class="f full">
                  <label for="cfgTos">Checkout terms text</label>
                  <textarea id="cfgTos" rows="3" placeholder="I accept the terms of service and the privacy policy."></textarea>
                </div>
              </div>
              <div style="margin-top:14px"><button class="btn btn-primary" onclick="saveConfig()">Save selling settings</button></div>
            </div>

            <div class="card">
              <h3>Upstream account</h3>
              <div id="upstreamBox" style="font-size:13px;color:var(--text-muted)">Not probed yet.</div>
            </div>
          </div>
        </div>
      </div>

      <!-- ============================ CATALOGUE ============================ -->
      <div class="pane" id="pane-catalogue">
        <div class="card">
          <h3>
            Sellable plans
            <span class="note">
              Cost = what you pay upstream · Retail = what the customer pays you.
              New plans from a sync start disabled — enable them deliberately.
            </span>
          </h3>
          <div style="display:flex;gap:8px;margin-bottom:13px;flex-wrap:wrap">
            <button class="btn btn-primary" onclick="syncCatalogue()">Sync from provider</button>
            <button class="btn" onclick="openConfigPlan()">+ Custom configuration plan</button>
            <select id="planProviderFilter" onchange="renderPlans()"
              style="padding:7px 10px;border-radius:8px;border:1px solid var(--border-color);background:rgba(255,255,255,.03);color:var(--text-primary);font-size:12px">
              <option value="">All providers</option>
            </select>
            <span style="flex:1"></span>
            <input id="planFilter" class="cell" style="max-width:220px;padding:7px 10px;border-radius:8px;border:1px solid var(--border-color);background:rgba(255,255,255,.03);color:var(--text-primary);font-size:12px" placeholder="Filter by name or CPU…" oninput="renderPlans()">
          </div>
          <div class="table-wrap">
            <table class="grid">
              <thead>
                <tr>
                  <th>On</th><th>Plan</th><th>Provider</th><th>CPU</th><th>vCPU</th><th>RAM</th><th>Disk</th>
                  <th>Net</th><th>IPs</th><th>Cost</th><th>Retail</th><th>Renew</th><th>Setup</th>
                  <th>Margin</th><th>Vis</th><th>Stock</th><th></th>
                </tr>
              </thead>
              <tbody id="planRows"></tbody>
            </table>
          </div>
        </div>

        <div class="card">
          <h3>Operating systems <span class="note">synced from GET /kvm/os</span></h3>
          <div class="table-wrap" style="max-height:320px">
            <table class="grid">
              <thead><tr><th>Upstream id</th><th>Name</th><th>Family</th><th>Windows</th><th>Min disk</th><th>Order</th><th></th></tr></thead>
              <tbody id="osRows"></tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ============================ ORDERS ============================ -->
      <div class="pane" id="pane-orders">
        <div class="card">
          <h3>
            Order queue
            <span class="note">
              <code>pending</code> orders are retried automatically with the same idempotency key — the provider
              replays its stored response instead of selling a second server.
            </span>
          </h3>
          <div style="display:flex;gap:8px;margin-bottom:13px;flex-wrap:wrap">
            <button class="btn btn-primary" onclick="openAdminOrder()">+ Order for a customer</button>
            <button class="btn" onclick="runSyncLoop()">Run reconciliation now</button>
