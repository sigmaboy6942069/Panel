<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Sign-in error' %></title>
  <link rel="icon" href="<%= typeof siteLogo !== 'undefined' ? siteLogo : '/images/logo.png' %>" type="image/png">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body style="display:flex;align-items:center;justify-content:center;min-height:100vh;background:var(--bg-primary,#09090f);padding:20px;">
  <div style="width:100%;max-width:420px;background:var(--bg-card,#12121d);border:1px solid var(--border-card,rgba(255,255,255,0.08));border-radius:16px;padding:28px;text-align:center;">
    <div style="font-size:34px;margin-bottom:10px;">🔒</div>
    <h2 style="margin:0 0 10px;color:var(--text-primary,#fff);font-size:18px;"><%= title %></h2>
    <p style="margin:0 0 20px;font-size:13px;line-height:1.6;color:var(--text-secondary,#cbd5e1);"><%= message %></p>
    <a href="/login" class="btn btn-primary" style="display:inline-flex;justify-content:center;padding:10px 18px;">
      Back to sign in
    </a>
  </div>
</body>
</html>
