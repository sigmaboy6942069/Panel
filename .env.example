# ============================================================================
# TGVPANEL — Unified KVM + LXC Virtualization Platform Configuration
# Copy this file to .env and customize for your deployment.
# ============================================================================

# Server Binding
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# Panel Branding
PANEL_NAME=TGVPANEL
PANEL_VERSION=V3.0
DEFAULT_LOGO_URL=/images/logo.png

# Data & Storage Directories
TGVPANEL_DATA_DIR=./data
TGVPANEL_VM_DIR=./storage/vms
TGVPANEL_LXC_DIR=/var/lib/lxc
TGVPANEL_BACKUP_DIR=./backups
TGVPANEL_ISO_DIR=./storage/iso
TGVPANEL_TEMPLATES_DIR=./storage/templates

# Security Secrets (auto-generated into .tgvpanel-secret if omitted)
SESSION_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
CSRF_SECRET=

# Admin Host PTY Shell Policy (set to true to unlock Interactive Host PTY on /admin/node-console)
TGVPANEL_ENABLE_NODE_SHELL=false

# Local Node Agent Integration
LOCAL_NODE_AGENT_PORT=5050
LOCAL_NODE_AGENT_HOST=127.0.0.1
NODE_AGENT_TLS_ENABLED=false

# Monitoring & Background Jobs
LIVE_STATS_VPS_INTERVAL_SEC=5
LIVE_STATS_NODE_INTERVAL_SEC=10
CPU_ALERT_THRESHOLD=90
RAM_ALERT_THRESHOLD=90
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_RETENTION=7

# Optional PostgreSQL Migration Target (see docs/POSTGRESQL_MIGRATION.md)
DATABASE_DRIVER=sqlite
DATABASE_URL=

# ============================================================================
# Standalone Remote Node Agent Settings (see docs/MULTINODE_SETUP.md)
# Used ONLY when running `npm run start:agent` or `tgvpanel-node-agent.service`
# ============================================================================
TGVPANEL_NODE_ID=
TGVPANEL_AGENT_HOST=0.0.0.0
TGVPANEL_AGENT_PORT=8443
TGVPANEL_NODE_API_KEY=
TGVPANEL_NODE_HMAC_SECRET=
TGVPANEL_ALLOWED_CONTROLLER_IPS=
TGVPANEL_AGENT_TLS_CERT=
TGVPANEL_AGENT_TLS_KEY=
TGVPANEL_AGENT_TLS_CA=
TGVPANEL_NODE_MTLS=false

# ============================================================================
# Upstream Reseller Integration (see docs/RESELLER_INTEGRATION.md)
# Sells KVM cloud servers from an upstream provider (Bukkit-Hosting, DE)
# straight into customer panel accounts. Everything also works from
# Admin → Reseller & Cloud; these variables are the headless fallbacks.
# ============================================================================
# Reseller API key (bkkt_…). Stored AES-256-GCM encrypted in the DB when set
# through the admin UI; the DB value wins over this variable.
RESELLER_API_KEY=
# Provider API v2 root (no trailing slash).
RESELLER_API_BASE_URL=https://bukkit-hosting.eu/api/v2
# How often queued orders are retried and server states/IPs refreshed.
RESELLER_POLL_INTERVAL_SEC=30
# How often the plan/OS catalogue is re-synced from the provider.
RESELLER_SYNC_INTERVAL_SEC=900
# Set to true to keep the reseller background jobs from starting (tests/CI).
TGVPANEL_DISABLE_RESELLER_POLLER=false
